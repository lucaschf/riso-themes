<!-- Generated by scripts/jetbrains.mjs from jetbrains/plugin.template.xml. -->
<idea-plugin>
  <id>lucascristovam.riso-themes</id>
  <name>Riso Themes</name>
  <version>0.1.0</version>
  <vendor url="https://github.com/lucaschf/riso-themes">Lucas Cristovam</vendor>

  <description><![CDATA[
    <p>Themes printed like a risograph: an ink on paper, a second ink, and nothing more.</p>
    <p>Eleven inks — Touge, Pink, Orange, Sunflower, Mustard, Green, Teal, Blue, Federal Blue,
    Purple, Grey — and the <b>Pink × Blue</b> duotone, each on three papers: near black,
    <b>Dimmed</b> and <b>Paper</b> (light). Every text color is checked for contrast on every paper.</p>
    <ul>
      <li><b>Rainbow brackets</b>: one color per nesting level, in any language.</li>
      <li><b>Color by name</b> (Python): every parameter, local, attribute, constant and class gets
      its own color, derived from its name — the same color as in the Riso VS Code extension.</li>
    </ul>
    <p>Both work under any theme and can be turned off in <i>Settings → Appearance → Riso</i>.
    The same palettes as the <a href="https://marketplace.visualstudio.com/items?itemName=lucascristovam.riso-themes">VS Code
    extension</a>, generated from one source.</p>
  ]]></description>

  <idea-version since-build="243"/>
  <depends>com.intellij.modules.platform</depends>
  <depends optional="true" config-file="riso-python.xml">com.intellij.modules.python</depends>

  <extensions defaultExtensionNs="com.intellij">
